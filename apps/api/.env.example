# Database (PostgreSQL). Use host `db` when running via docker compose.
DATABASE_URL=postgresql://nomad:nomad@localhost:5432/nomad_ledger

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# App
DEBUG=false

# Receipt item categorization (any OpenAI-compatible chat-completions API).
# Leave LLM_API_KEY empty to import receipt items without categories.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash-lite
